# mac-setup Brewfile — `brew bundle --file=Brewfile`

# --- Shell & prompt
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# --- Modern CLI
brew "eza"          # ls replacement (aliased as l/ll/la/lt, not `ls`)
brew "fzf"
brew "zoxide"       # smarter cd: z, zi
brew "bat"
brew "ripgrep"      # rg
brew "fd"
brew "jq"
brew "btop"
brew "tlrc"         # tldr pages
brew "git"
brew "git-delta"
brew "gh"
brew "lazygit"
brew "tmux"

# --- yazi file manager + preview helpers (light set)
brew "yazi"
brew "sevenzip"
brew "poppler"

# --- Dev
brew "neovim"
brew "uv"           # Python versions, venvs, packages
brew "node"         # some LSPs in Neovim/Mason need it

# --- Apps
cask "ghostty"      # terminal (macOS 13+)
cask "zed"          # student's editor
cask "font-jetbrains-mono-nerd-font"
